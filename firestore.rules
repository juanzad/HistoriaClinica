rules_version = '2';

// Cada usuario solo puede leer y escribir su propio historial en users/{uid}.
// Todo lo demás (incluida la antigua colección "patients") queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{subcollection}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && subcollection in ['events', 'sideEffects', 'metrics', 'files', 'fileChunks']
          && request.resource.data.id == docId;
      }
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
  }
}
